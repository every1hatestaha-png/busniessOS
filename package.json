{
  "name": "business-os",
  "version": "0.1.0",
  "description": "BusinessOS - Accounting, Inventory & Sales Management",
  "author": "BusinessOS",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && node desktop/postbuild.cjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.8.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "svix": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.businessos.desktop",
    "productName": "BusinessOS",
    "asar": true,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "package.json",
      "!node_modules/**/*",
      "!**/.env*",
      "!**/*.pem"
    ],
    "extraResources": [
      {
        "from": ".desktop-stage/next",
        "to": "next"
      }
    ],
    "afterPack": "desktop/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BusinessOS",
      "menuCategory": "BusinessOS",
      "uninstallDisplayName": "BusinessOS",
      "deleteAppDataOnUninstall": false
    }
  }
}
