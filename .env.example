NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# PostgreSQL Database URL
DATABASE_URL=

# Groq is optional. Keep this server-side only; never expose it through NEXT_PUBLIC_* or commit a real key.
# MunshiOS uses the free-capable GPT-OSS 20B model by default and falls back to deterministic live-data answers if Groq is unavailable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Email address allowed to access the MunshiOS platform owner control plane at /platform
MUNSHIOS_PLATFORM_OWNER_EMAIL=
