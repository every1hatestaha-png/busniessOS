NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# PostgreSQL Database URL
DATABASE_URL=

# Groq is optional. Keep this server-side only; never expose it through NEXT_PUBLIC_* or commit a real key.
# MunshiOS uses the free-capable GPT-OSS 20B model by default and falls back to deterministic live-data answers if Groq is unavailable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Email address allowed to access the MunshiOS platform owner control plane at /platform
MUNSHIOS_PLATFORM_OWNER_EMAIL=

# FBR Digital Invoicing. Keep all credentials server-side.
# Production is independently default-deny. Set to 1 only after the live-integration release checklist is complete.
FBR_DI_PRODUCTION_TRANSMISSION_ENABLED=0

# Shared credentials are disabled by default. Prefer workspace-scoped secrets in multi-tenant deployments.
FBR_DI_ALLOW_SHARED_TOKEN=0
FBR_DI_SANDBOX_BEARER_TOKEN=
FBR_DI_PRODUCTION_BEARER_TOKEN=

# Preferred workspace-scoped naming convention. Normalize workspace IDs by replacing non-alphanumerics with underscores and uppercasing.
# FBR_DI_SANDBOX_TOKEN_<NORMALIZED_WORKSPACE_ID>=
# FBR_DI_PRODUCTION_TOKEN_<NORMALIZED_WORKSPACE_ID>=

# Public marketing site
# Canonical production URL used by metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://business-os-one-gules.vercel.app
# WhatsApp number in international format without +, for example 923001234567.
NEXT_PUBLIC_MUNSHIOS_WHATSAPP=
