generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------
// ENUMS
// ----------------------------------------

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum BusinessType {
  WHOLESALER
  DISTRIBUTOR
  MANUFACTURER
  RETAILER
  OTHER
}

enum ProductUnit {
  PIECE
  BOX
  CARTON
  KG
  SET
  LITER
  METER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum CreditNoteStatus {
  OPEN
  PARTIALLY_APPLIED
  APPLIED
  CANCELLED
}

enum SupplierReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CHEQUE
  CREDIT_CARD
  MOBILE_WALLET
  OTHER
}

enum DocumentKind {
  SALES_ORDER
  PURCHASE_ORDER
  INVOICE
  PAYMENT_RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  EXPENSE_VOUCHER
  BANK_PAYMENT_VOUCHER
  PURCHASE_RECEIPT
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COST_OF_SALES
  EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum AccountSystemCode {
  CASH_IN_HAND
  BANK
  ACCOUNTS_RECEIVABLE
  INVENTORY
  ACCOUNTS_PAYABLE
  WITHHOLDING_TAX_PAYABLE
  OWNER_EQUITY
  SALES_REVENUE
  OTHER_INCOME
  COST_OF_GOODS_SOLD
  SALARY_EXPENSE
  ELECTRICITY_EXPENSE
  RENT_EXPENSE
  FUEL_EXPENSE
  TRANSPORT_EXPENSE
  FACTORY_EXPENSE
  OFFICE_EXPENSE
  REPAIRS_EXPENSE
  OTHER_OPERATING_EXPENSE
}

enum GeneralLedgerSourceType {
  EXPENSE
  PAYMENT
  RECEIPT
  SALE
  PURCHASE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT
  PURCHASE_RECEIPT
  REVERSAL
}

enum LedgerEntryType {
  OPENING_BALANCE
  SALE
  PURCHASE
  PAYMENT_RECEIVED
  PAYMENT_MADE
  ADJUSTMENT
  REVERSAL
  CREDIT_NOTE
  DEBIT_NOTE
  SALES_RETURN
  PURCHASE_RETURN
  GOODS_RECEIVED
}

enum InventoryTransactionType {
  OPENING_STOCK
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  SALE_CANCELLATION
  PURCHASE_CANCELLATION
  PURCHASE_RECEIPT
}

enum PricingMode {
  UNIT
  WEIGHT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ----------------------------------------
// TENANT & AUTH MODELS
// ----------------------------------------

model Workspace {
  id           String       @id @default(uuid())
  name         String
  phone        String?
  email        String?
  address      String?
  city         String?
  country      String       @default("Pakistan")
  currency     String       @default("PKR")
  timezone     String       @default("Asia/Karachi")
  businessType BusinessType @default(WHOLESALER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members                   WorkspaceMember[]
  customers                 Customer[]
  suppliers                 Supplier[]
  products                  Product[]
  inventoryTransactions     InventoryTransaction[]
  salesOrders               SalesOrder[]
  purchaseOrders            PurchaseOrder[]
  invoices                  Invoice[]
  payments                  Payment[]
  ledgerEntries             LedgerEntry[]
  documentSequences         DocumentSequence[]
  auditLogs                 AuditLog[]
  invitations               WorkspaceInvitation[]
  paymentAllocations        PaymentAllocation[]
  creditNotes               CreditNote[]
  debitNotes                DebitNote[]
  customerReturns           CustomerReturn[]
  supplierReturns           SupplierReturn[]
  accounts                  Account[]
  cashBankAccounts          CashBankAccount[]
  expenses                  Expense[]
  generalLedgerEntries      GeneralLedgerEntry[]
  goodReceivedNotes         GoodReceivedNote[]
  customerCreditAllocations CustomerCreditAllocation[]

  @@map("workspaces")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          WorkspaceMember[]
  auditLogs            AuditLog[]
  invitationsSent      WorkspaceInvitation[] @relation("InvitationSender")
  generalLedgerEntries GeneralLedgerEntry[]

  @@map("users")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        Role     @default(STAFF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ----------------------------------------
// CORE BUSINESS ENTITIES
// ----------------------------------------

model Customer {
  id             String         @id @default(uuid())
  workspaceId    String
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  city           String?
  creditLimit    Decimal        @default(0) @db.Decimal(15, 2)
  currentBalance Decimal        @default(0) @db.Decimal(15, 2)
  notes          String?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  creditNotes   CreditNote[]
  returns       CustomerReturn[]

  @@index([workspaceId])
  @@map("customers")
}

model Supplier {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  city           String?
  currentBalance Decimal  @default(0) @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseOrders     PurchaseOrder[]
  payments           Payment[]
  ledgerEntries      LedgerEntry[]
  debitNotes         DebitNote[]
  returns            SupplierReturn[]
  goodsReceivedNotes GoodReceivedNote[]

  @@index([workspaceId])
  @@map("suppliers")
}

model Product {
  id            String        @id @default(uuid())
  workspaceId   String
  name          String
  sku           String?
  description   String?
  category      String?
  costPrice     Decimal       @default(0) @db.Decimal(15, 2)
  sellingPrice  Decimal       @default(0) @db.Decimal(15, 2)
  stockQuantity Decimal       @default(0) @db.Decimal(15, 4)
  reorderLevel  Decimal       @default(0) @db.Decimal(15, 4)
  unit          ProductUnit   @default(PIECE)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inventoryTransactions InventoryTransaction[]
  salesOrderItems       SalesOrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodReceivedNoteItems GoodReceivedNoteItem[]
  supplierReturnItems   SupplierReturnItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@map("products")
}

// ----------------------------------------
// ACCOUNTING CORE
// ----------------------------------------

model Account {
  id            String               @id @default(uuid())
  workspaceId   String
  code          String
  name          String
  category      AccountCategory
  normalBalance AccountNormalBalance
  systemCode    AccountSystemCode?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashBankAccounts     CashBankAccount[]
  expenses             Expense[]            @relation("ExpenseAccount")
  paidExpenses         Expense[]            @relation("ExpensePaymentAccount")
  generalLedgerEntries GeneralLedgerEntry[]

  @@unique([workspaceId, code])
  @@unique([workspaceId, systemCode])
  @@index([workspaceId, category])
  @@map("accounts")
}

model CashBankAccount {
  id             String   @id @default(uuid())
  workspaceId    String
  accountId      String
  name           String
  openingBalance Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance Decimal  @default(0) @db.Decimal(15, 2)
  isBank         Boolean  @default(false)
  bankName       String?
  accountNumber  String?
  accountTitle   String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@unique([workspaceId, accountId])
  @@index([workspaceId, isActive])
  @@map("cash_bank_accounts")
}

model Expense {
  id               String   @id @default(uuid())
  workspaceId      String
  expenseAccountId String
  paymentAccountId String
  voucherNumber    String
  expenseDate      DateTime @default(now())
  amount           Decimal  @db.Decimal(15, 2)
  payee            String?
  reference        String?
  notes            String?
  idempotencyKey   String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenseAccount Account   @relation("ExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  paymentAccount Account   @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, voucherNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, expenseDate])
  @@index([workspaceId, expenseAccountId])
  @@map("expenses")
}

model GeneralLedgerEntry {
  id             String                  @id @default(uuid())
  workspaceId    String
  accountId      String
  sourceType     GeneralLedgerSourceType
  sourceId       String
  documentNo     String
  date           DateTime                @default(now())
  narration      String
  debit          Decimal                 @default(0) @db.Decimal(15, 2)
  credit         Decimal                 @default(0) @db.Decimal(15, 2)
  reversalOfId   String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime                @default(now())

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account    Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reversalOf GeneralLedgerEntry?  @relation("GeneralLedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals  GeneralLedgerEntry[] @relation("GeneralLedgerReversal")
  reversedBy User?                @relation(fields: [reversedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, reversalOfId])
  @@index([workspaceId, accountId, date])
  @@index([workspaceId, accountId, date, createdAt, id])
  @@index([workspaceId, sourceType, sourceId])
  @@map("general_ledger_entries")
}

// ----------------------------------------
// INVENTORY & TRANSACTIONS
// ----------------------------------------

model InventoryTransaction {
  id              String                   @id @default(uuid())
  workspaceId     String
  productId       String
  type            InventoryTransactionType
  quantityChanged Decimal                  @db.Decimal(15, 4)
  unitCost        Decimal?                 @db.Decimal(15, 2)
  reference       String? // Order ID or adjustment reason
  createdAt       DateTime                 @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([workspaceId, productId])
  @@index([workspaceId, type, createdAt])
  @@map("inventory_transactions")
}

model SalesOrder {
  id             String           @id @default(uuid())
  workspaceId    String
  customerId     String
  orderNumber    String
  status         SalesOrderStatus @default(DRAFT)
  subtotal       Decimal          @default(0) @db.Decimal(15, 2)
  discount       Decimal          @default(0) @db.Decimal(15, 2)
  total          Decimal          @default(0) @db.Decimal(15, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(15, 2)
  balanceAmount  Decimal          @default(0) @db.Decimal(15, 2)
  notes          String?
  idempotencyKey String?
  orderDate      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cancelledAt    DateTime?
  cancelledById  String?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       SalesOrderItem[]
  invoices    Invoice[]
  creditNotes CreditNote[]
  returns     CustomerReturn[]

  @@unique([workspaceId, orderNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([workspaceId, customerId])
  @@index([workspaceId, orderDate, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String   @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Decimal  @db.Decimal(15, 4)
  unitPrice    Decimal  @db.Decimal(15, 2)
  discount     Decimal  @default(0) @db.Decimal(15, 2)
  totalPrice   Decimal  @db.Decimal(15, 2)
  productName  String?
  productSku   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@map("sales_order_items")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  workspaceId          String
  supplierId           String
  orderNumber          String
  status               PurchaseOrderStatus @default(DRAFT)
  totalAmount          Decimal             @default(0) @db.Decimal(15, 2)
  paidAmount           Decimal             @default(0) @db.Decimal(15, 2)
  balanceAmount        Decimal             @default(0) @db.Decimal(15, 2)
  idempotencyKey       String?
  notes                String?
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  department           String?
  pricingMode          PricingMode         @default(UNIT)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  cancelledAt          DateTime?
  cancelledById        String?

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items              PurchaseOrderItem[]
  debitNotes         DebitNote[]
  returns            SupplierReturn[]
  paymentAllocations PaymentAllocation[]
  goodsReceivedNotes GoodReceivedNote[]

  @@unique([workspaceId, orderNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([workspaceId, supplierId])
  @@index([workspaceId, supplierId, status, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal  @db.Decimal(15, 4)
  unitCost         Decimal  @db.Decimal(15, 2)
  totalCost        Decimal  @db.Decimal(15, 2)
  receivedQuantity Decimal  @default(0) @db.Decimal(15, 4)
  unitWeight       Decimal? @db.Decimal(10, 3)
  totalWeight      Decimal? @db.Decimal(15, 3)
  perKgRate        Decimal? @db.Decimal(15, 2)
  productName      String?
  productSku       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder       PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product             Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceivedItems  GoodReceivedNoteItem[]
  supplierReturnItems SupplierReturnItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodReceivedNote {
  id              String   @id @default(uuid())
  workspaceId     String
  supplierId      String
  purchaseOrderId String
  grnNumber       String
  idempotencyKey  String?
  receiptDate     DateTime @default(now())
  notes           String?
  receivedBy      String?
  checkedBy       String?
  totalAmount     Decimal  @default(0) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier        Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items           GoodReceivedNoteItem[]
  supplierReturns SupplierReturn[]

  @@unique([workspaceId, grnNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, purchaseOrderId])
  @@index([workspaceId, supplierId])
  @@map("goods_received_notes")
}

model GoodReceivedNoteItem {
  id                  String   @id @default(uuid())
  goodReceivedNoteId  String
  purchaseOrderItemId String
  productId           String
  orderedQuantity     Decimal  @db.Decimal(15, 4)
  receivedQuantity    Decimal  @db.Decimal(15, 4)
  acceptedQuantity    Decimal  @db.Decimal(15, 4)
  unitCost            Decimal  @db.Decimal(15, 2)
  totalCost           Decimal  @db.Decimal(15, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  goodReceivedNote  GoodReceivedNote  @relation(fields: [goodReceivedNoteId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodReceivedNoteId])
  @@map("goods_received_note_items")
}

model Invoice {
  id            String        @id @default(uuid())
  workspaceId   String
  customerId    String
  salesOrderId  String?
  invoiceNumber String
  status        InvoiceStatus @default(UNPAID)
  amount        Decimal       @db.Decimal(15, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(15, 2)
  creditApplied Decimal       @default(0) @db.Decimal(15, 2)
  dueDate       DateTime?
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer          Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder        SalesOrder?                @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  payments          Payment[]
  allocations       PaymentAllocation[]
  creditAllocations CustomerCreditAllocation[]

  @@unique([workspaceId, invoiceNumber])
  @@unique([salesOrderId])
  @@index([workspaceId, status])
  @@index([workspaceId, issuedAt])
  @@index([workspaceId, customerId])
  @@index([workspaceId, customerId, status, dueDate])
  @@map("invoices")
}

// ----------------------------------------
// KHATA (LEDGER) & PAYMENTS
// ----------------------------------------

model Payment {
  id                   String        @id @default(uuid())
  workspaceId          String
  customerId           String? // Null if paying a supplier
  supplierId           String? // Null if receiving from a customer
  invoiceId            String?
  cashBankAccountId    String?
  documentNumber       String?
  idempotencyKey       String?
  amount               Decimal       @db.Decimal(15, 2)
  netAmount            Decimal?      @db.Decimal(15, 2)
  withholdingTaxAmount Decimal       @default(0) @db.Decimal(15, 2)
  method               PaymentMethod @default(CASH)
  reference            String? // Cheque number, transaction ID, etc.
  notes                String?
  paymentDate          DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  isReversed           Boolean       @default(false)
  reversedAt           DateTime?
  reversalOfId         String?

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoice         Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashBankAccount CashBankAccount?    @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  reversalOf      Payment?            @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       Payment[]           @relation("PaymentReversal")
  allocations     PaymentAllocation[]

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, documentNumber])
  @@index([workspaceId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, supplierId])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, cashBankAccountId])
  @@index([workspaceId, customerId, paymentDate])
  @@index([workspaceId, supplierId, paymentDate])
  @@index([reversalOfId])
  @@map("payments")
}

model DocumentSequence {
  id          String       @id @default(uuid())
  workspaceId String
  kind        DocumentKind
  nextNumber  Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
  @@map("document_sequences")
}

model LedgerEntry {
  id          String          @id @default(uuid())
  workspaceId String
  customerId  String?
  supplierId  String?
  type        LedgerEntryType
  debit       Decimal         @default(0) @db.Decimal(15, 2)
  credit      Decimal         @default(0) @db.Decimal(15, 2)
  description String?
  referenceId String? // ID of Invoice, Payment, Order etc.
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, supplierId])
  @@index([workspaceId, customerId, date, createdAt])
  @@index([workspaceId, supplierId, date, createdAt])
  @@map("ledger_entries")
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@map("audit_logs")
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  workspaceId String
  email       String
  role        Role             @default(STAFF)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
  @@map("workspace_invitations")
}

// ----------------------------------------
// PHASE 2D: ALLOCATIONS, NOTES & RETURNS
// ----------------------------------------

model PaymentAllocation {
  id              String   @id @default(uuid())
  workspaceId     String
  paymentId       String
  invoiceId       String?
  purchaseOrderId String?
  amount          Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([purchaseOrderId])
  @@map("payment_allocations")
}

model CreditNote {
  id               String           @id @default(uuid())
  workspaceId      String
  customerId       String
  salesOrderId     String?
  customerReturnId String?          @unique
  number           String
  reason           String
  amount           Decimal          @db.Decimal(15, 2)
  appliedAmount    Decimal          @default(0) @db.Decimal(15, 2)
  remainingAmount  Decimal          @default(0) @db.Decimal(15, 2)
  status           CreditNoteStatus @default(OPEN)
  reference        String?
  notes            String?
  date             DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace      Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer       Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder     SalesOrder?                @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customerReturn CustomerReturn?            @relation(fields: [customerReturnId], references: [id], onDelete: SetNull)
  allocations    CustomerCreditAllocation[]

  @@unique([workspaceId, number])
  @@unique([workspaceId, customerReturnId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, customerId, date])
  @@index([workspaceId, status])
  @@map("credit_notes")
}

model CustomerCreditAllocation {
  id             String   @id @default(uuid())
  workspaceId    String
  creditNoteId   String
  invoiceId      String
  amount         Decimal  @db.Decimal(15, 2)
  idempotencyKey String?
  createdAt      DateTime @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, creditNoteId])
  @@index([workspaceId, invoiceId])
  @@map("customer_credit_allocations")
}

model DebitNote {
  id              String   @id @default(uuid())
  workspaceId     String
  supplierId      String
  purchaseOrderId String?
  number          String
  reason          String
  amount          Decimal  @db.Decimal(15, 2)
  reference       String?
  notes           String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, number])
  @@index([workspaceId, supplierId])
  @@map("debit_notes")
}

model CustomerReturn {
  id             String   @id @default(uuid())
  workspaceId    String
  customerId     String
  salesOrderId   String
  idempotencyKey String?
  number         String
  reason         String?
  totalAmount    Decimal  @db.Decimal(15, 2)
  restock        Boolean  @default(true)
  notes          String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  creditNote CreditNote?
  items      CustomerReturnItem[]

  @@unique([workspaceId, number])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, customerId])
  @@index([workspaceId, salesOrderId])
  @@map("customer_returns")
}

model CustomerReturnItem {
  id               String   @id @default(uuid())
  customerReturnId String
  salesOrderItemId String
  productId        String
  quantity         Decimal  @db.Decimal(15, 4)
  unitPrice        Decimal  @db.Decimal(15, 2)
  totalPrice       Decimal  @db.Decimal(15, 2)
  createdAt        DateTime @default(now())

  customerReturn CustomerReturn @relation(fields: [customerReturnId], references: [id], onDelete: Cascade)

  @@index([customerReturnId])
  @@index([salesOrderItemId])
  @@map("customer_return_items")
}

model SupplierReturn {
  id                 String               @id @default(uuid())
  workspaceId        String
  supplierId         String
  purchaseOrderId    String
  goodReceivedNoteId String?
  idempotencyKey     String?
  number             String
  status             SupplierReturnStatus @default(POSTED)
  reason             String?
  totalAmount        Decimal              @db.Decimal(15, 2)
  notes              String?
  date               DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier         Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder    PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  goodReceivedNote GoodReceivedNote?    @relation(fields: [goodReceivedNoteId], references: [id], onDelete: SetNull)
  items            SupplierReturnItem[]

  @@unique([workspaceId, number])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, supplierId])
  @@index([workspaceId, purchaseOrderId])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id                     String   @id @default(uuid())
  supplierReturnId       String
  purchaseOrderItemId    String
  productId              String
  goodReceivedNoteItemId String?
  quantity               Decimal  @db.Decimal(15, 4)
  unitCost               Decimal  @db.Decimal(15, 2)
  totalCost              Decimal  @db.Decimal(15, 2)
  createdAt              DateTime @default(now())

  supplierReturn    SupplierReturn    @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@index([supplierReturnId])
  @@index([purchaseOrderItemId])
  @@map("supplier_return_items")
}
